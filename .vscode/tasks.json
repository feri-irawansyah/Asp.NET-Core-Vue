{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "setup",
            "dependsOn": ["setup:frontend", "setup:backend"],
            "dependsOrder": "sequence"
        },
        {
            "label": "setup:frontend",
            "type": "shell",
            "command": "npm ci",
            "options": {
                "cwd": "${workspaceFolder}/src/OnboardingClient",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            }
        },
        {
            "label": "setup:backend",
            "type": "shell",
            "command": "dotnet tool restore",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            }
        },
        {
            "label": "setup:husky",
            "type": "shell",
            "command": "dotnet husky install",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            }
        },
        {
            "label": "setup",
            "dependsOn": ["setup:frontend", "setup:backend", "setup:husky"],
            "dependsOrder": "sequence"
        }
    ]
}
